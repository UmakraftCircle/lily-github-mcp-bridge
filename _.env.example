# GitHub Personal Access Token. Fine-grained token scoped to only the
# repo(s) you list in ALLOWED_REPOS is strongly recommended, with just
# "Contents: Read and write" permission.
GITHUB_TOKEN=

# A long random secret. This is the "password" gating the OAuth /authorize
# page, and it also signs the bearer tokens this server issues to Claude.
# Generate one with: openssl rand -hex 32
MCP_ADMIN_SECRET=

# The public HTTPS URL this server will be reachable at once deployed.
# No trailing slash. e.g. https://lily-mcp.onrender.com
MCP_BASE_URL=

# Comma-separated "owner/repo" allowlist. The bridge refuses to touch any
# repo not listed here, regardless of what the PAT itself can access.
ALLOWED_REPOS=UmakraftCircle/DmLilyAi

# Optional: port to listen on locally / in a container. Most PaaS platforms
# set this automatically.
PORT=3232
